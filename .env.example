# Backed — environment template. Copy to .env.local and fill. NEVER commit real keys.

# --- Payment (48h productized service: €49 / €99 / €199 Stripe payment links) ---
# Paste the live Stripe Payment Link URLs here, then reference them from the CTA buttons.
NEXT_PUBLIC_STRIPE_LINK_STARTER=
NEXT_PUBLIC_STRIPE_LINK_FULL=
NEXT_PUBLIC_STRIPE_LINK_PREMIUM=

# --- Intake (Tally / Typeform form that collects results + photos) ---
NEXT_PUBLIC_INTAKE_URL=

# --- Contact (where the kit's "Say yes" form should post, once wired) ---
# e.g. a Formspree / Tally endpoint. Demo build does not send anything yet.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://backed.team
