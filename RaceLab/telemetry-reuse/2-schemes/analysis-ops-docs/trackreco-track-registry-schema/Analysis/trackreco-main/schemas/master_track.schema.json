{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MasterTrack",
  "type": "object",
  "required": [
    "venue_id", "canonical_name", "country", "outdoor_status", "karting_status",
    "existing_status", "recurring_venue_status", "acceptance_confidence_score",
    "acceptance_reason_codes", "source_count", "first_seen_at", "last_checked_at"
  ],
  "properties": {
    "venue_id": {"type": "string"},
    "canonical_name": {"type": "string"},
    "aliases": {"type": "array", "items": {"type": "string"}},
    "country": {"type": "string"},
    "subdivision": {"type": ["string", "null"]},
    "locality": {"type": ["string", "null"]},
    "postal_code": {"type": ["string", "null"]},
    "full_address": {"type": ["string", "null"]},
    "outdoor_status": {"type": "string"},
    "mixed_mode_flag": {"type": "boolean"},
    "karting_status": {"type": "string"},
    "existing_status": {"type": "string"},
    "recurring_venue_status": {"type": "string"},
    "official_website": {"type": ["string", "null"]},
    "contact_phone": {"type": ["string", "null"]},
    "contact_email": {"type": ["string", "null"]},
    "lat": {"type": ["number", "null"]},
    "lon": {"type": ["number", "null"]},
    "point_geom": {"type": ["string", "null"]},
    "bbox_geom": {"type": ["string", "null"]},
    "initial_working_bbox": {"type": ["string", "null"]},
    "osm_refs": {"type": "array", "items": {"type": "string"}},
    "source_geometry_refs": {"type": "array", "items": {"type": "string"}},
    "acceptance_confidence_score": {"type": "number"},
    "acceptance_reason_codes": {"type": "array", "items": {"type": "string"}},
    "primary_evidence_summary": {"type": "string"},
    "source_count": {"type": "integer"},
    "source_types_present": {"type": "array", "items": {"type": "string"}},
    "first_seen_at": {"type": "string"},
    "last_checked_at": {"type": "string"},
    "created_by_pipeline_version": {"type": "string"},
    "parser_versions": {"type": "array", "items": {"type": "string"}},
    "review_status": {"type": "string"},
    "review_notes": {"type": ["string", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string"}}
  }
}
