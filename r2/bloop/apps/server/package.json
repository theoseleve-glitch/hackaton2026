{
  "name": "@bloop/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:bundle": "wrangler deploy --dry-run --outdir dist/bundle-check && node scripts/check-bundle.mjs dist/bundle-check"
  },
  "dependencies": {
    "@bloop/engine": "workspace:*",
    "@bloop/game-option-vote": "workspace:*",
    "@bloop/game-tracer": "workspace:*",
    "@bloop/kit": "workspace:*",
    "@bloop/protocol": "workspace:*",
    "hono": "^4.12.0",
    "obscenity": "^0.4.6",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "^4.20260610.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.0",
    "wrangler": "^4.72.0"
  }
}
